{
  "name": "painel-pipelines",
  "private": true,
  "type": "module",
  "description": "Plataforma de gestão de automação de testes: descobrir, configurar, executar, monitorar, analisar e compartilhar resultados de pipelines.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @painel/api",
    "dev:worker": "npm run dev -w @painel/worker",
    "dev:web": "npm run dev -w @painel/web",
    "migrate": "node apps/api/src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-sensitive.mjs",
    "test": "vitest run",
    "build:web": "npm run build -w @painel/web",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
