# Copie para .env e troque TODOS os valores. Nunca versione o .env (RNF-033).
POSTGRES_PASSWORD=troque-esta-senha-admin
APP_DB_PASSWORD=troque-esta-senha-app
S3_ACCESS_KEY=troque-esta-chave
S3_SECRET_KEY=troque-este-segredo
S3_BUCKET=painel-artifacts
# 32 bytes em base64, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=troque-por-32-bytes-em-base64
# Guarde a chave com o backup: perdê-la torna ilegíveis as credenciais dos provedores.
# Azure DevOps Server instalado na empresa (além de dev.azure.com e *.visualstudio.com), separado por vírgula.
AZURE_DEVOPS_EXTRA_HOSTS=
# GitHub Enterprise Server instalado na empresa (além de github.com), separado por vírgula.
GITHUB_EXTRA_HOSTS=
# E-mail (opcional): SMTP da sua instalação. smtp://usuario:senha@host:587 (STARTTLS) ou smtps://...:465.
# Sem ele, convites, redefinição de senha e avisos ficam só no painel (o link aparece para quem gerou).
SMTP_URL=
SMTP_FROM=Nexo <nexo@sua-empresa.example>
PUBLIC_BASE_URL=http://localhost:8080
REPORT_ORIGIN_URL=http://localhost:8081
# Produção com domínio e TLS (docs/implantacao-producao.md): use https:// nos dois endereços acima,
# com hosts diferentes, e descomente a linha abaixo para o proxy subir nas portas 80/443.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
LOG_LEVEL=info
# Sessão e links de acesso (ADR-011). Opcionais; os valores abaixo são os padrões.
# SESSION_IDLE_MINUTES=480
# SESSION_ABSOLUTE_HOURS=168
# INVITE_TTL_HOURS=72
# PASSWORD_RESET_TTL_HOURS=24
# AUTH_RATE_LIMIT_PER_MINUTE=20
